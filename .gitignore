# ============================================================
# Recall AI 智能错题本 · .gitignore
# 目标：只提交「源码 + 文档 + 配置样例」，排除依赖、密钥、本地数据
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---------- Node / 前端 ----------
node_modules/
dist/
.vite/
*.tsbuildinfo
*.local

# ---------- 环境变量 / 密钥（切勿提交真实密钥） ----------
# 排除所有真实 .env，但保留 .env.example 样例
.env
.env.*
!.env.example

# ---------- 数据库 / 向量库 / 上传（本地用户数据，不入库） ----------
*.db
*.sqlite
*.sqlite3
chroma_data/
uploads/
*.log

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- 其他产物 ----------
__pycache__/
.cache/
.tmp/
